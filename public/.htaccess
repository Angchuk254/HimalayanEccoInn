# Himalayan Eco Inn - Apache config for prerendered static site
# Prerendered pages: /, /about, /rooms, etc. have their own index.html
# Admin and 404: fallback to index.html for client-side routing

RewriteEngine On
RewriteBase /

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Remove trailing slashes (except for directories)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [L,R=301]

# If not a real file or directory, serve index.html (admin, 404)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# Enable gzip compression for text files (SEO performance boost)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# Cache static assets with longer expiry
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 7 days"
  
  # Long cache (1 month) for versioned/hashed assets
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 month"
  ExpiresByType application/font-woff "access plus 1 month"
  
  # 1 week for CSS/JS (can be updated independently)
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"
  
  # Short cache for HTML/XML (content changes regularly)
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
</IfModule>

# Add cache control headers
<IfModule mod_headers.c>
  # HTML: revalidate hourly
  <FilesMatch "\.(html|xml)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  
  # CSS/JS: cache for 1 week
  <FilesMatch "\.(css|js|woff|woff2)$">
    Header set Cache-Control "public, max-age=604800, immutable"
  </FilesMatch>
  
  # Images: cache for 1 month
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
  
  # Security headers
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  
  # UTF-8 charset
  Header set Content-Type "text/html; charset=UTF-8"
</IfModule>

# Ensure correct MIME types
<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType application/json .json
  AddEncoding gzip .gz
  AddType image/svg+xml svg
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType font/ttf .ttf
  AddCharset UTF-8 .html .xml .js .css
</IfModule>
